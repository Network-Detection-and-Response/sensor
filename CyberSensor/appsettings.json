{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "CyberSensor": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "CyberSensor": "Information"
      }
    }
  },
  "Sensor": {
    "SensorId": "core_switch_mirror",
    "NetworkInterfaceName": "",
    "NetworkInterfaceIndex": 0,
    "CaptureFilter": "ip",
    "Snaplen": 65536,
    "PromiscuousMode": true,
    "ReadTimeoutMilliseconds": 1000,
    "LogPacketDetail": false,
    "RateLimiter": {
      "MaxPacketsPerSecondPerIp": 3000,
      "MaxTrackedIps": 65536,
      "RateLimiterEnabled": true
    },
    "Aggregator": {
      "FlowTableCapacity": 65536,
      "FlowIdleTimeout": "00:00:30",
      "FlowHardTimeout": "00:05:00",
      "IncludeMacAddresses": true
    },
    "Channels": {
      "PacketChannelCapacity": 50000
    },
    "Batch": {
      "MaxBatchSize": 500,
      "FlushInterval": "00:00:03"
    },
    "Backend": {
      "BaseUrl": "http://localhost:8080",
      "FlowsEndpoint": "/api/v1/flows",
      "ApiKey": "change-me-sensor-key",
      "Timeout": "00:00:10"
    }
  }
}
