{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "CyberSensor": "Information"
    }
  },
  "Sensor": {
    "SensorId": "core_switch_mirror",
    "NetworkInterfaceName": "",
    "NetworkInterfaceIndex": 0,
    "CaptureFilter": "ip",
    "Snaplen": 65536,
    "PromiscuousMode": true,
    "ReadTimeoutMilliseconds": 1000,
    "RateLimiter": {
      "Mode": "TokenBucket",
      "PermitsPerSecondPerSourceIp": 4000,
      "BurstPerSourceIp": 4000,
      "GlobalPermitsPerSecond": 0
    },
    "Aggregator": {
      "FlowTableCapacity": 65536,
      "FlowIdleTimeout": "00:00:30",
      "FlowHardTimeout": "00:05:00",
      "IncludeMacAddresses": true
    },
    "Channels": {
      "PacketChannelCapacity": 65536,
      "PacketChannelFullMode": "DropOldest",
      "FlowChannelCapacity": 16384,
      "FlowChannelFullMode": "Wait"
    },
    "Batch": {
      "MaxBatchSize": 500,
      "FlushInterval": "00:00:05"
    },
    "Backend": {
      "BaseUrl": "http://localhost:5000",
      "FlowsEndpoint": "/api/flows",
      "ApiKey": null,
      "Timeout": "00:00:10",
      "MaxRetries": 3
    }
  }
}
